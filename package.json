{
  "name": "redproxy",
  "version": "0.2.0",
  "private": true,
  "description": "TOTP-gated dynamic one-time CRX3 extension that temporarily changes Chrome proxy settings and self-uninstalls.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server/src/index.js",
  "bin": {
    "redproxy": "dist/server/src/index.js"
  },
  "scripts": {
    "embed": "tsx scripts/embed-assets.ts",
    "prebuild": "npm run embed",
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "npm run build && bun build --compile --minify --outfile dist/redproxy server/src/index.ts",
    "dev": "tsx watch server/src/index.ts",
    "start": "node dist/server/src/index.js",
    "cli": "tsx server/src/cli.ts",
    "lint": "eslint \"server/src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:key": "tsx server/src/cli.ts generate-key"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "crx3": "^2.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^8.57.1",
    "jszip": "^3.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}

# --- RedProxy example configuration. Never commit a real .env file. ---
PORT=3000
PUBLIC_BASE_URL=https://example.com
# Leave ADMIN_TOTP_SECRET empty to let the server generate and persist a fresh
# secret in DATA_DIR/totp-secret.txt on first startup.
ADMIN_TOTP_SECRET=
SESSION_TTL_SECONDS=3600
SESSION_IDLE_SECONDS=90
MAX_CONCURRENT_DEVICES=2
COOKIE_SECURE=true
DATA_DIR=./data
CRX_PRIVATE_KEY_PATH=./data/redproxy.pem

# Optional hardening knobs
NODE_ENV=production
AUTH_SESSION_TTL_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
CRX_KEY_BITS=2048
TRUST_PROXY=false
# Local development only: set true if you really must serve extension tokens over HTTP.
ALLOW_INSECURE_HTTP=false

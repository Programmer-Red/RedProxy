# --- RedProxy example configuration. Never commit a real .env file. ---

# Server
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://example.com
NODE_ENV=production
DATA_DIR=./data
CRX_PRIVATE_KEY_PATH=./data/redproxy.pem

# Authentication
# totp = TOTP only (default, most secure simple mode)
# totp_password = TOTP + a separate admin password
AUTH_MODE=totp
# Optional. If empty, a random secret is generated into DATA_DIR/settings.json
# on first start and shown as a QR code in the admin panel.
ADMIN_TOTP_SECRET=
# Optional first-run admin password. Prefer setting it from the admin panel
# after the first login instead of keeping it in .env.
ADMIN_PASSWORD=
COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BAN_SECONDS=900

# Sessions / extension
SESSION_TTL_SECONDS=3600
SESSION_IDLE_SECONDS=90
ENROLLMENT_TTL_SECONDS=120
TOKEN_GRACE_SECONDS=30
MAX_CONCURRENT_DEVICES=2

# CRX
CRX_KEY_BITS=2048

# Reverse proxy / local testing
TRUST_PROXY=false
# Only set true for local HTTP acceptance. Keep false when PUBLIC_BASE_URL is https.
ALLOW_INSECURE_HTTP=false

# Optional overrides (normally leave empty and use files bundled with the binary)
STATIC_DIR=
EXTENSION_TEMPLATE_DIR=

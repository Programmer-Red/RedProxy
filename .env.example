# --- RedProxy example configuration. Never commit a real .env file. ---

# --- User portal (end users generate the one-time extension here) ---
HOST=0.0.0.0
PORT=3000
# URL written into generated extensions. Must be reachable by the browser.
PUBLIC_BASE_URL=https://example.com

# --- Admin portal (separate site, separate login session) ---
ADMIN_ENABLED=true
# Default binds to loopback only. Put it behind HTTPS/reverse proxy or firewall.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001

# --- General ---
NODE_ENV=production
DATA_DIR=./data
CRX_PRIVATE_KEY_PATH=./data/redproxy.pem

# --- Authentication ---
# Admin portal login: totp = TOTP only, totp_password = TOTP + admin password.
# The user portal always requires TOTP only.
AUTH_MODE=totp
# Optional. If empty, a random secret is generated into DATA_DIR/settings.json
# on first start and shown as a QR code in the admin portal.
ADMIN_TOTP_SECRET=
# Optional first-run admin password. Prefer setting it in the admin portal.
ADMIN_PASSWORD=
COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BAN_SECONDS=900

# --- Sessions / extension ---
SESSION_TTL_SECONDS=3600
SESSION_IDLE_SECONDS=90
ENROLLMENT_TTL_SECONDS=120
TOKEN_GRACE_SECONDS=30
MAX_CONCURRENT_DEVICES=2

# --- CRX ---
CRX_KEY_BITS=2048

# --- Reverse proxy / local testing ---
TRUST_PROXY=false
# Only set true for local HTTP acceptance. Keep false when PUBLIC_BASE_URL is https.
ALLOW_INSECURE_HTTP=false

# Optional overrides (normally leave empty and use files bundled with the binary)
STATIC_DIR=
EXTENSION_TEMPLATE_DIR=
